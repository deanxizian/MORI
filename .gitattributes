# Current editable Blender models; generated mesh caches stay in the archive.
*.blend filter=lfs diff=lfs merge=lfs -text

# Suppress local line diffs for serialized CAD; GitHub may still expand it.
# Large native PCB/footprint sources are delivered in lossless ordinary-Git ZIPs.
# These files remain ordinary Git blobs, unchanged from the received snapshot.
*.kicad_pcb binary
*.kicad_sch binary
*.kicad_mod binary
*.kicad_sym binary
*.stl binary
*.step binary
*.stp binary
*.obj binary
*.npz binary
