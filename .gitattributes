# Current editable Blender models; generated mesh caches stay in the archive.
*.blend filter=lfs diff=lfs merge=lfs -text

# Serialized native CAD is reviewed in KiCad/Blender, not as line-oriented code.
# These files remain ordinary Git blobs, unchanged from the received snapshot.
*.kicad_pcb binary
*.kicad_sch binary
*.kicad_mod binary
*.kicad_sym binary
*.stl binary
*.step binary
*.stp binary
*.obj binary
*.npz binary
