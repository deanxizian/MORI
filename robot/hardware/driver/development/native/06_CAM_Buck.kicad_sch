ects (font (size 1.3 1.3)) (justify left)) (uuid 13697d7d-bdf1-5511-ba00-59ab65f7987e))(text "反馈分压：54.9k / 10k，0.1%，25ppm/°C；基准 0.581–0.611V。容差计算见 cam_power.json。" (at 25.4 208.28 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid a0cf01a0-a123-5de5-a15c-9b3bffe42cd0))(text "C703–C705 合计标称 66µF；直流偏压下的有效容量、环路与负载阶跃稳定性仍须实测。" (at 25.4 218.44 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid 34a8546d-5b5e-57d0-97df-14ee0cab241e))(text "C707 = 100pF 是待验证起点；PCB 上必须缩短 VIN–C701–GND、SW–L701 与 C706 回路。" (at 25.4 228.6 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid 8677a022-8744-5fec-8e00-e0b5eee2791b))(text "目标负载：连续 1.5A / 瞬态 1.7A；摄像头 + 屏幕 + Wi-Fi + 音频并发负载尚未实测。" (at 25.4 238.76 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid 14cff55e-0292-5902-b9c7-5d3085022749))(text "候选板 70×35 mm，布线未完成；XH6 插合、弯线及整机装配空间尚未验证。" (at 25.4 248.92 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid 284bb67a-06b1-5737-b060-ebde55d924af))(text "输入滤波 → 降压开关 → 电感 / 输出滤波 → 反馈；下一级见第 8 页。" (at 25.4 31.75 0) (effects (font (size 1.3 1.3)) (justify left)) (uuid d164f973-ef4e-5913-8c61-0cf3325b0fbd))(hierarchical_label "UPS_5V" (shape bidirectional) (at 40.64 76.2 0.0) (effects (font (size 1 1)) (justify left)) (uuid 6a938cd3-a57a-5426-af83-72a4f442d0de))(hierarchical_label "CAM_REG_3V87" (shape bidirectional) (at 365.76 96.52 0.0) (effects (font (size 1 1)) (justify left)) (uuid 6aaa48dd-3f9c-5e99-9b18-7ef00ddd6351))(text "J701A 是同一只 XH6 的 5V / GND 两针；其余四针见 UPS I2C 与直供开关页。" (at 25.4 184.15 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid d1eb15d6-d8fd-4b3e-ac72-654d4d4f766c)))
