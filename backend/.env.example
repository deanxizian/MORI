# Local default needs no service keys. Never commit .env.
MORI_PROVIDER=mock
MORI_DATA_DIR=/data
MORI_ALLOWED_ORIGINS=https://mori.example.com,capacitor://localhost,http://localhost,https://localhost
MORI_DOMAIN=mori.example.com
# Each device/client gets a revocable one-time-paired credential; no master key in UI.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou
TENCENT_LLM_MODEL=hunyuan-turbo
TENCENT_VOICE_TYPE=1001
# Empty means live calls forbidden. Monthly call cap, NOT a price guarantee.
MORI_API_CALL_LIMIT=
VLM_HTTPS_ENDPOINT=
VLM_API_KEY=
VLM_MODEL=
# Per-month actual billing should be reconciled in Tencent console; no auto recharge.
