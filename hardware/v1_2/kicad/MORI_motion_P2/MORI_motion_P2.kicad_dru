(rule "R01 via-pad physical any net"
  (condition "(A.Type == 'Via' && B.Type == 'Pad') || (B.Type == 'Via' && A.Type == 'Pad')")
  (constraint physical_clearance (min 0.1999996mm))
)

(rule "R05-R07 hole to copper"
  (constraint hole_clearance (min 0.2999994mm))
)

(rule "R09 signal width"
  (constraint track_width (min 0.1999996mm) (opt 0.1999996mm) (max 2.00000108mm))
)

(rule "R08 power and return width"
  (condition "(A.NetName == '/+3V3' || A.NetName == '/+5V_MOTION' || A.NetName == '/CAM_3V3') || (A.NetName == '/GND')")
  (constraint track_width (min 0.1999996mm) (opt 0.499999mm) (max 5.00000016mm))
)

(rule "R29 absolute holes"
  (constraint hole_size (min 0.0999998mm) (max 5.00000016mm))
)

(rule "R15-R16 through via geometry"
  (condition "A.Type == 'Via'")
  (constraint via_diameter (min 0.499999mm) (opt 0.499999mm) (max 1.00000054mm))
  (constraint hole_size (min 0.2499995mm) (opt 0.2499995mm) (max 0.499999mm))
  (constraint assertion "A.Via_Type == 'Through'")
)

(rule "R23 via count"
  (constraint via_count (max 500))
)

(rule "R27 minimum track angle"
  (condition "A.Type == 'Track' && B.Type == 'Track'")
  (constraint track_angle (min 60))
)

(rule "R26 solid polygon connection"
  (constraint zone_connection solid)
)

(rule "R25 through-hole thermals"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
  (constraint zone_connection thermal_reliefs)
  (constraint thermal_relief_gap (opt 0.254mm))
  (constraint thermal_spoke_width (opt 0.2999994mm))
  (constraint min_resolved_spokes 4)
)

(rule "R43 silk-to-silk"
  (condition "A.Layer == B.Layer")
  (constraint silk_clearance (min 0.0499999mm))
)

(rule "R42 silk-to-exposed-pad"
  (condition "A.Type == 'Pad' || B.Type == 'Pad'")
  (constraint silk_clearance (min 0.00999998mm))
)

(rule "R39 differential geometry"
  (condition "A.inDiffPair('*')")
  (constraint track_width (min 0.381mm) (opt 0.381mm) (max 0.381mm))
  (constraint diff_pair_gap (min 0.254mm) (opt 0.254mm) (max 0.254mm))
  (constraint diff_pair_uncoupled (max 12.7mm))
)

(rule "R40 hole-to-hole"
  (constraint hole_to_hole (min 0.1499997mm))
)

(rule "MORI existing copper-to-edge"
  (constraint edge_clearance (min 0.50mm))
)
